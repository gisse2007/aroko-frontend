/*
  # ── Seguridad básica (WCAG/Lighthouse Best Practices) ──
  # CSP: ajusta connect-src/img-src si tu API de producción NO es localhost:3000
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: blob: https://images.unsplash.com https://*.tile.openstreetmap.org https://res.cloudinary.com http://localhost:3000 https://*.onrender.com; connect-src 'self' http://localhost:3000 https://*.onrender.com; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'
  # HSTS: activo solo cuando el sitio se sirve por HTTPS
  Strict-Transport-Security: max-age=63072000; includeSubDomains; preload
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Resource-Policy: same-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(self), payment=()

/assets/*
  Cache-Control: public, max-age=31536000, immutable